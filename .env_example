# Google Gemini API key (required for cloud summarization)
GEMINI_API_KEY=

# Mastodon credentials (optional; required only for posting to Mastodon)
MASTODON_SERVER=https://your.instance
MASTODON_CLIENT_KEY=
MASTODON_CLIENT_SECRET=
MASTODON_ACCESS_TOKEN=

# Logging verbosity (optional; default: INFO)
LOG_LEVEL=INFO

# Local Ollama fallback (optional; used when all Gemini models are unavailable)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# API server host/port (optional; used by api.py)
API_HOST=0.0.0.0
API_PORT=8000
